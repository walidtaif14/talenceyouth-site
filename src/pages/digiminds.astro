---
import Base from '../layouts/Base.astro';
import Photo from '../components/Photo.astro';
import Galerie from '../components/Galerie.astro';
import { asso, digiminds as d, clauseUE } from '../data/site';
import bordeaux from '../assets/photos/bordeaux-toits.jpg';
import forteresse from '../assets/photos/blanquefort-forteresse.jpg';
import majolan from '../assets/photos/blanquefort-majolan.jpg';

const programme = [
  { jour: 'Lun. 19', matin: 'Arrivée et installation', apres: 'Dîner de bienvenue et jeux pour retenir les prénoms' },
  { jour: 'Mar. 20', matin: 'Jeux pour former les équipes et Mission Impossible', apres: 'Règles de vie, craintes et attentes' },
  { jour: 'Mer. 21', matin: "Atelier : qu'est-ce que l'IA ? Son histoire", apres: 'Débat « peur ou opportunité », premiers pas avec les outils' },
  { jour: 'Jeu. 22', matin: 'Jeu de simulation : The Troll Factory', apres: 'Atelier : les outils pour vérifier une information' },
  { jour: 'Ven. 23', matin: 'Atelier : reconnaître un deepfake', apres: 'Bilan de mi-parcours' },
  { jour: 'Sam. 24', matin: 'Bordeaux Day : jeu photo et défis en équipes mixtes dans toute la ville', apres: '', fort: true },
  { jour: 'Dim. 25', matin: 'Écriture des scénarios et tournage des vidéos', apres: 'Écriture du Manifeste numérique' },
  { jour: 'Lun. 26', matin: 'Montage des vidéos, fin du Manifeste', apres: 'Présentation des résultats' },
  { jour: 'Mar. 27', matin: 'Préparation des ateliers locaux, bilan final, auto-évaluation Youthpass', apres: 'Remise des Youthpass et soirée de départ' },
  { jour: 'Mer. 28', matin: "Mur d'évaluation, cercle d'au revoir et départ", apres: '' },
];
const apprendre = [
  { t: 'Parler à une IA', p: 'Écrire de bonnes consignes pour obtenir ce que vous voulez.' },
  { t: 'Vérifier une information', p: "Avec la recherche d'image inversée de Google et l'outil InVID." },
  { t: 'Comprendre les algorithmes', p: "Comment ils fonctionnent et pourquoi l'IA invente parfois des choses." },
  { t: 'Protéger votre vie privée', p: 'Votre empreinte numérique et vos droits.' },
  { t: 'Prendre la parole', p: 'Débattre, travailler en équipe internationale, oser parler anglais.' },
  { t: 'Créer ensemble', p: 'Le Youth Digital Manifesto, des vidéos sur les deepfakes et une présentation publique des résultats.' },
];
const partenairesDm = [
  { pays: 'France', nom: 'TalenceYouth', role: 'Coordonne et accueille' },
  { pays: 'Italie', nom: 'Associazione SINGA', role: "Anime les ateliers techniques sur l'IA" },
  { pays: 'Turquie', nom: 'Antalya Erasmus Sports Club', role: "L'humain face à l'IA, dialogue interculturel" },
  { pays: 'Pologne', nom: 'ŻYJ KOLOROWO!', role: 'Jeux de lancement et cohésion des équipes' },
  { pays: 'Lituanie', nom: 'Linkuva Youth & Children Centre', role: 'Inclusion des jeunes des zones rurales' },
];
---
<Base
  titre="DigiMinds, échange Erasmus+ sur l'IA à Bordeaux, juillet 2027"
  description="Du 19 au 28 juillet 2027 à Blanquefort, près de Bordeaux : 10 jours pour comprendre l'IA et repérer les fausses informations avec des jeunes de 5 pays. 6 places pour le groupe français, sans frais de participation. Candidatures ouvertes."
>
  <section class="ty-section ty-section--top">
    <div class="ty-split">
      <div>
        <span class="ty-badge"><span class="dot"></span>Échange de jeunes Erasmus+, KA152</span>
        <h1 class="ty-h1">DigiMinds, esprit critique face à l'IA</h1>
        <p class="ty-lead">Dix jours à Bordeaux pour comprendre comment fonctionne l'intelligence artificielle, apprendre à repérer les fausses informations et créer des vidéos avec des jeunes de cinq pays.</p>
        <div class="ty-actions">
          <a class="ty-btn" href="#candidater"><span>Candidater</span><span class="fleche" aria-hidden="true">→</span></a>
          <a class="ty-btn2" href="#programme">Voir le programme</a>
        </div>
      </div>
      <div style="position:relative;">
        <div class="ty-photo-card">
          <Photo src={bordeaux} prioritaire alt="Les toits du vieux Bordeaux vus depuis la porte Cailhau" style="aspect-ratio:4/3;object-fit:cover;" />
        </div>
        <div class="ty-float-card" style="bottom:22px;left:-16px;--r:-4deg;animation:ty-float 6s ease-in-out infinite;">
          <strong>19-28 juillet</strong><span>2027, Bordeaux</span>
        </div>
      </div>
    </div>
  </section>

  <section class="ty-section" aria-label="Chiffres clés">
    <div class="ty-stats" data-reveal>
      <div><b>{d.personnes}</b><p>personnes de 5 pays</p></div>
      <div><b>{d.groupeFrancais.jeunes}</b><p>places pour le groupe français</p></div>
      <div><b>{d.jours}</b><p>jours à Blanquefort</p></div>
      <div><b>0 <em>€</em></b><p>de frais de participation</p></div>
    </div>
  </section>

  <section class="ty-section">
    <div class="ty-head">
      <div>
        <span class="ty-eyebrow" data-reveal>En une minute</span>
        <h2 class="ty-h2" data-reveal>Ce qu'il faut savoir</h2>
      </div>
    </div>
    <div class="ty-card" data-reveal>
      <dl class="ty-facts">
        <dt>Quand</dt><dd>Du lundi 19 au mercredi 28 juillet 2027, 10 jours.</dd>
        <dt>Où</dt><dd>À {d.lieu}. Depuis Bordeaux Saint-Jean, le train s'arrête à la gare de Blanquefort, à 12 minutes à pied.</dd>
        <dt>Qui</dt><dd>{d.personnes} personnes de 5 pays : {d.participants} participants, {d.chefsDeGroupe} chefs de groupe et 1 animateur.</dd>
        <dt>Le groupe français</dt><dd>{d.groupeFrancais.jeunes} jeunes et un chef de groupe de l'association. Au moins {d.groupeFrancais.moinsOpportunites} des {d.groupeFrancais.jeunes} places vont à des jeunes qui ont moins d'occasions de partir.</dd>
        <dt>Âge</dt><dd>De {d.age}.</dd>
        <dt>Langue</dt><dd>Un anglais simple et on s'entraide dans les groupes.</dd>
        <dt>Ce que ça coûte</dt><dd>Pas de frais de participation : l'auberge, les repas et les activités sont pris en charge par Erasmus+. Vos achats personnels restent à votre charge.</dd>
        <dt>Ce que vous y gagnez</dt><dd>Un Youthpass (le certificat européen de vos compétences, à mettre sur votre CV), des compétences numériques et des amis de 5 pays.</dd>
      </dl>
    </div>
  </section>

  <section class="ty-section">
    <div class="ty-head">
      <div>
        <span class="ty-eyebrow" data-reveal>Ce que vous allez apprendre</span>
        <h2 class="ty-h2" data-reveal>Pas de cours magistral, on apprend en faisant</h2>
      </div>
      <span class="ty-muted" data-reveal style="max-width:420px;">Dans The Troll Factory, un jeu de simulation, vous fabriquez de fausses informations pour comprendre comment elles circulent.</span>
    </div>
    <div class="ty-cards">
      {apprendre.map((a) => (
        <article class="ty-card ty-point" data-reveal><h3>{a.t}</h3><p>{a.p}</p></article>
      ))}
    </div>
    <p class="ty-muted" data-reveal style="margin:22px 0 0;">Il y aura aussi des débats en World Café, des ateliers sur tablettes et ordinateurs, des soirées interculturelles où chaque pays partage sa cuisine et sa musique, plus des moments sans écran.</p>
  </section>

  <section id="programme" class="ty-section">
    <div class="ty-head">
      <div>
        <span class="ty-eyebrow" data-reveal>Jour par jour</span>
        <h2 class="ty-h2" data-reveal>Le programme</h2>
      </div>
      <span class="ty-muted" data-reveal style="max-width:420px;">Les chefs de groupe fixent le programme final lors de la visite préparatoire d'avril 2027.</span>
    </div>
    <div class="ty-card" data-reveal style="overflow-x:auto;">
      <table class="ty-table">
        <thead><tr><th scope="col">Jour</th><th scope="col">Matin</th><th scope="col">Après-midi et soir</th></tr></thead>
        <tbody>
          {programme.map((p) => (
            <tr class={p.fort ? 'fort' : undefined}>
              <th scope="row">{p.jour}</th>
              <td colspan={p.apres ? undefined : 2}>{p.matin}</td>
              {p.apres && <td>{p.apres}</td>}
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="ty-muted" data-reveal style="margin:18px 0 0;">Chaque soir, 30 minutes en petit groupe mixte pour parler de la journée.</p>
  </section>

  <section class="ty-section">
    <div class="ty-split" style="align-items:flex-start;">
      <div>
        <span class="ty-eyebrow" data-reveal>Où vous dormez</span>
        <h2 class="ty-h2" data-reveal>L'auberge de jeunesse de Blanquefort</h2>
        <div class="ty-text" data-reveal style="margin-top:20px;">
          <p>Juste au nord de Bordeaux, dans des chambres de 3 ou 4 avec salle de bain, filles et garçons séparés. Il y a le Wi-Fi, une laverie et un jardin, pensez à votre serviette. Petit-déjeuner, panier-repas le midi et dîner chaud le soir, avec des repas végétariens, halal ou sans allergène si vous le signalez à l'avance.</p>
          <p>À côté : le parc de Majolan et la forteresse médiévale de Blanquefort.</p>
        </div>
      </div>
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px;">
        <div class="ty-photo-card" data-reveal style="border-radius:20px;"><Photo src={forteresse} alt="La forteresse médiévale de Blanquefort" largeurs={[400, 700]} sizes="(min-width: 800px) 300px, 50vw" style="aspect-ratio:4/5;object-fit:cover;" /></div>
        <div class="ty-photo-card" data-reveal style="border-radius:20px;"><Photo src={majolan} alt="Le parc de Majolan à Blanquefort" largeurs={[400, 700]} sizes="(min-width: 800px) 300px, 50vw" style="aspect-ratio:4/5;object-fit:cover;" /></div>
      </div>
    </div>
  </section>

  <section class="ty-section">
    <div class="ty-cards">
      <article class="ty-card" data-reveal>
        <span class="ty-eyebrow">Ce qu'on attend de vous</span>
        <div class="ty-text">
          <p>Être là les 10 jours et participer à toutes les activités.</p>
          <p>Venir à la réunion de préparation et faire une petite recherche sur l'IA et les fausses informations en France, avec un vrai exemple.</p>
          <p>Aider le groupe à animer une activité près de chez vous dans les 2 mois après l'échange.</p>
          <p style="margin:0;">Raconter ce que vous avez vécu dans au moins une publication sur vos réseaux.</p>
        </div>
      </article>
      <article class="ty-card" data-reveal>
        <span class="ty-eyebrow">Les dates</span>
        <dl class="ty-facts">
          <dt>Maintenant</dt><dd>Les candidatures du groupe français sont ouvertes.</dd>
          <dt>Avant le 31 mai 2027</dt><dd>Liste des participants arrêtée.</dd>
          <dt>À partir du 21 juin 2027</dt><dd>Groupe en ligne et réunion de préparation.</dd>
          <dt>19-28 juillet 2027</dt><dd>L'échange.</dd>
        </dl>
      </article>
    </div>
  </section>

  <section class="ty-section">
    <div class="ty-card" data-reveal style="border-radius:28px;padding:clamp(24px,3.5vw,44px);">
      <span class="ty-eyebrow">Les partenaires</span>
      <h2 class="ty-h2" style="margin-bottom:22px;">5 associations, 5 pays</h2>
      <div class="ty-cards" style="gap:14px;">
        {partenairesDm.map((p) => (
          <div style="background:#f6f4f1;border:1px solid #ece9e4;border-radius:16px;padding:16px 18px;">
            <div style="font-size:12px;font-weight:600;color:var(--accent);">{p.pays}</div>
            <div style="font-family:'Hanken Grotesk';font-weight:800;font-size:1.05rem;margin:4px 0 6px;">{p.nom}</div>
            <div style="font-size:14px;color:#4a463f;line-height:1.5;">{p.role}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section id="candidater" class="ty-section">
    <div class="ty-split" style="align-items:stretch;">
      <article class="ty-card-bleue" data-reveal>
        <span aria-hidden="true" style="width:48px;height:48px;border-radius:14px;background:rgba(255,255,255,.15);display:flex;align-items:center;justify-content:center;font-size:22px;margin-bottom:20px;">✈</span>
        <h2 class="ty-h2" style="margin-bottom:14px;">Candidater à DigiMinds</h2>
        <p>Vous avez entre 18 et 30 ans le 19 juillet 2027, vous vivez en France et vous pouvez rester les 10 jours ? Remplissez le formulaire, cela prend quelques minutes. Si vous avez besoin d'un aménagement (santé, régime alimentaire, accessibilité), indiquez-le dedans.</p>
        <p style="margin:24px 0 0;"><a class="ty-btn ty-btn--clair" href={d.formulaire} target="_blank" rel="noopener"><span>Remplir le formulaire</span><span class="fleche" aria-hidden="true">→</span></a></p>
        <p style="margin:20px 0 0;font-size:14px;">Une question avant de candidater ? Écrivez-nous sur <a href={asso.instagram} target="_blank" rel="noopener">Instagram</a> ou à <a href={`mailto:${asso.email}`}>{asso.email}</a>.</p>
      </article>
      <div class="ty-faq" data-reveal>
        <details>
          <summary>Je n'ai jamais quitté la France, est-ce un problème ?</summary>
          <div><p>Pas du tout, d'ailleurs l'échange a lieu à Bordeaux. Dites-le à la réunion de préparation, c'est fait pour ça.</p></div>
        </details>
        <details>
          <summary>Faut-il savoir coder ?</summary>
          <div><p>Non. On cherche des personnes curieuses qui veulent comprendre ce qui se passe avec l'IA et le partager.</p></div>
        </details>
        <details>
          <summary>Halal, végétarien, allergie : comment ça se passe ?</summary>
          <div><p>Dites-le-nous à l'avance, c'est prévu : végétarien, halal, sans porc ou sans allergène.</p></div>
        </details>
        <details>
          <summary>Puis-je venir seulement quelques jours ?</summary>
          <div><p>Non, il faut pouvoir rester les 10 jours et participer à toutes les activités, c'est une condition pour partir.</p></div>
        </details>
        <details>
          <summary>Je suis parent, qui accompagne les jeunes ?</summary>
          <div><p>Un chef de groupe de l'association accompagne le groupe français pendant tout l'échange. Pour toute question, écrivez-nous à <a href={`mailto:${asso.email}`}>{asso.email}</a>.</p></div>
        </details>
      </div>
    </div>
  </section>

  <section class="ty-section">
    <div class="ty-head">
      <div>
        <span class="ty-eyebrow" data-reveal>Bordeaux et Blanquefort</span>
        <h2 class="ty-h2" data-reveal>Là où se passe l'échange</h2>
      </div>
      <span class="ty-muted" data-reveal>Cliquez pour agrandir</span>
    </div>
    <Galerie items={[
      { src: bordeaux, legende: 'Les toits du vieux Bordeaux', large: true },
      { src: forteresse, legende: 'La forteresse de Blanquefort' },
      { src: majolan, legende: 'Le parc de Majolan' },
    ]} />
    <p class="ty-caption" style="margin-top:28px;max-width:760px;">Projet Erasmus+ n° {d.reference}. {clauseUE.fr}</p>
    <p class="ty-caption" style="max-width:760px;">Photos de Wikimedia Commons, recadrées : toits de Bordeaux par Zairon (CC BY-SA 4.0), forteresse de Blanquefort par Joel Camelot (CC BY 3.0), parc de Majolan par Michel Buze (domaine public).</p>
  </section>
</Base>
