---
import Base from '../layouts/Base.astro';
import Photo from '../components/Photo.astro';
import { asso, subventions, eurosEn, digiminds, partenaires } from '../data/site';
import teeBerlinUe from '../assets/photos/tee-berlin-centre-ue.jpg';

const fiche = `Organisation: TalenceYouth
Country: France (Talence, Bordeaux area, Nouvelle-Aquitaine)
OID: ${asso.oid}
Legal status: non-profit association (French law of 1901), founded in 2025
Address: ${asso.adresse}, France
Email: ${asso.email}
Website: https://talenceyouth.fr
Legal representative: Walid Taif, President
Experience: KA152 coordinator (DigiMinds, 5 countries, ${digiminds.datesEn}), KA155 DiscoverEU Inclusion coordinator (Talence-Europe Express, August 2026), sending partner in KA152 youth exchanges
Target group: young people aged 18 to 30 from the Bordeaux area, including young people with fewer opportunities
Topics: AI and disinformation, inclusion, European citizenship, sustainable mobility, mental health, audiovisual storytelling
Working languages: English, French, Italian, Spanish, Arabic`;
---
<Base
  lang="en"
  titre="TalenceYouth, Erasmus+ youth partner in Bordeaux, France"
  description="TalenceYouth is a youth association from Talence, next to Bordeaux, France. We coordinate and join Erasmus+ youth projects (KA152, KA155). OID E10403043. Our partner identification sheet, ready to copy."
>
  <section class="section" aria-labelledby="titre-partners">
    <div class="formes" aria-hidden="true">
      <span class="forme forme--rond" style="width:min(50vw,440px);height:min(50vw,440px);right:-14vw;top:-6vw"></span>
    </div>
    <div class="conteneur deux-colonnes au-dessus">
      <div>
        <h1 id="titre-partners"><span class="de-travers encre-bleue">Looking for a partner in Bordeaux?</span></h1>
        <p class="chapeau" style="margin-top:24px">We're TalenceYouth, a youth association from Talence, right next to Bordeaux. We coordinate Erasmus+ youth projects and we send groups to our partners' exchanges. We work with young people aged 18 to 30, many of them with fewer opportunities.</p>
        <p style="margin-top:24px"><a class="bouton" href="#fiche">Copy our partner sheet</a></p>
      </div>
      <Photo src={teeBerlinUe} riso="bleu" prioritaire ratio="4 / 5" sizes="(min-width: 860px) 420px, 100vw" largeurs={[420, 840]}
        alt="Young people from our Talence-Europe Express group with an EU flag at the European Commission information centre in Berlin"
        legende="Berlin, August 2026: our DiscoverEU group at the European Commission information centre." />
    </div>
  </section>

  <section class="section section--filet" aria-labelledby="titre-facts">
    <div class="conteneur deux-colonnes">
      <h2 id="titre-facts"><span class="de-travers">Key facts</span></h2>
      <dl class="faits">
        <dt>OID</dt><dd>{asso.oid}</dd>
        <dt>Status</dt><dd>Non-profit association under the French law of 1901, founded in March 2025. Five volunteers run it.</dd>
        <dt>Based in</dt><dd>Talence, Bordeaux area, Nouvelle-Aquitaine, France</dd>
        <dt>Grants won</dt><dd>{eurosEn(subventions.digiminds)} for DigiMinds (KA152, coordinator) and {eurosEn(subventions.tee)} for Talence-Europe Express (KA155 DiscoverEU Inclusion, completed in 2026)</dd>
        <dt>Languages</dt><dd>English, French, Italian, Spanish, Arabic</dd>
      </dl>
    </div>
  </section>

  <section class="section section--filet" aria-labelledby="titre-done">
    <div class="conteneur deux-colonnes">
      <h2 id="titre-done"><span class="de-travers">What we've done</span></h2>
      <ul class="filets">
        <li><b>DigiMinds, KA152 youth exchange, coordinator</b>{digiminds.datesEn} near Bordeaux, 36 people from France, Italy, Türkiye, Poland and Lithuania, on AI, fake news and critical thinking.</li>
        <li><b>Talence-Europe Express, KA155 DiscoverEU Inclusion, coordinator</b>August 2026, 11 days by train from Bordeaux to Berlin with five young people who'd never travelled without their parents. Seven left and seven came back.</li>
        <li><b>Act for Inclusion: Empathy on Stage, KA152, sending partner</b>July 2027, a youth exchange on theatre and inclusion coordinated by BİLSEM Denizli (Türkiye).</li>
        <li><b>Earlier exchanges</b>Our young people took part in exchanges in Skien (Norway) in 2025, in Romania in 2025 and in Nogaret (France) with In Orbita in 2026.</li>
      </ul>
    </div>
  </section>

  <section class="section section--jaune" aria-labelledby="titre-bring">
    <div class="conteneur deux-colonnes">
      <h2 id="titre-bring"><span class="de-travers">What we bring</span></h2>
      <ul class="filets">
        <li><b>A host in the Bordeaux area</b>We're hosting DigiMinds near Bordeaux in July 2027 and we can host other exchanges in the area.</li>
        <li><b>Motivated groups</b>Young people from the Bordeaux area, prepared before they leave and followed after they come back.</li>
        <li><b>Video</b>Our vice-president films our projects, so results don't stay in a drawer.</li>
        <li><b>Topics we work on</b>AI and disinformation, inclusion, European citizenship, sustainable mobility, mental health, audiovisual storytelling.</li>
      </ul>
    </div>
  </section>

  <section id="fiche" class="section section--filet" aria-labelledby="titre-fiche">
    <div class="conteneur">
      <h2 id="titre-fiche"><span class="de-travers">Our partner sheet</span></h2>
      <p class="texte" style="margin-top:24px">Everything you usually ask for in a partner identification form, ready to paste into your application.</p>
      <p><button type="button" class="bouton" data-copier="fiche-texte" hidden>Copy to clipboard</button> <span role="status" aria-live="polite" data-copie-etat></span></p>
      <pre class="fiche" id="fiche-texte">{fiche}</pre>
    </div>
  </section>

  <section class="section section--filet" aria-labelledby="titre-network">
    <div class="conteneur deux-colonnes">
      <h2 id="titre-network"><span class="de-travers">Our partners</span></h2>
      <ul class="filets">
        {partenaires.map((p) => (
          <li>{p.nom}, {p.country}{p.city ? `, ${p.city}` : ''}</li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section section--bleu" aria-labelledby="titre-contact">
    <div class="conteneur deux-colonnes">
      <h2 id="titre-contact"><span class="de-travers">Let's talk</span></h2>
      <div class="texte">
        <p>Write to us at <a href={`mailto:${asso.email}`}>{asso.email}</a>, in English, French, Italian or Spanish. Tell us about your project and your timeline. We'll get back to you.</p>
      </div>
    </div>
  </section>
</Base>

<script>
  const bouton = document.querySelector<HTMLButtonElement>('[data-copier]');
  const etat = document.querySelector('[data-copie-etat]');
  if (bouton && navigator.clipboard) {
    bouton.hidden = false;
    bouton.addEventListener('click', async () => {
      const texte = document.getElementById(bouton.dataset.copier || '')?.textContent || '';
      try {
        await navigator.clipboard.writeText(texte);
        if (etat) etat.textContent = 'Copied.';
      } catch {
        if (etat) etat.textContent = 'Copy failed, please select the text below.';
      }
    });
  }
</script>
