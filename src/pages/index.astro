---
import Base from '../layouts/Base.astro';
import Photo from '../components/Photo.astro';
import Galerie from '../components/Galerie.astro';
import { asso, digiminds, totalSubventions, nombrePaysPartenaires } from '../data/site';

import teeNdsm from '../assets/photos/tee-ndsm.jpg';
import teeGroupe from '../assets/photos/tee-groupe-berlin.jpg';
import teeBerlinUe from '../assets/photos/tee-berlin-centre-ue.jpg';
import teeAmsterdam from '../assets/photos/tee-amsterdam.jpg';
import skien from '../assets/photos/skien.jpg';
import nogaret from '../assets/photos/nogaret.jpg';
import nogaret2 from '../assets/photos/nogaret-2.jpg';
import nogaretCroix from '../assets/photos/nogaret-croix.jpg';
import norvege1 from '../assets/photos/norvege-1.jpg';
import norvege2 from '../assets/photos/norvege-2.jpg';
import roumanie from '../assets/photos/roumanie.jpg';

const jsonld = {
  '@context': 'https://schema.org',
  '@type': 'NGO',
  name: asso.nom,
  url: 'https://talenceyouth.fr',
  logo: 'https://talenceyouth.fr/images/logo-192.png',
  email: asso.email,
  foundingDate: '2025-03-27',
  address: { '@type': 'PostalAddress', streetAddress: '16 avenue de Collegno', postalCode: '33400', addressLocality: 'Talence', addressCountry: 'FR' },
  sameAs: [asso.instagram],
};
const chip = 'background:#f1efeb;color:#4a463f;font-size:12px;font-weight:500;padding:5px 11px;border-radius:9999px;';
const pchip = 'background:#f1efeb;font-size:13px;font-weight:500;padding:7px 13px;border-radius:9999px;';
---
<Base
  titre="TalenceYouth, mobilités Erasmus+ pour les jeunes de Talence et Bordeaux"
  description="TalenceYouth conçoit et coordonne des mobilités internationales pour les jeunes de 18 à 30 ans via Erasmus+, depuis Talence et Bordeaux vers toute l'Europe. DigiMinds, du 19 au 28 juillet 2027 : candidatures ouvertes."
  jsonld={jsonld}
>

  <!-- ===================== HERO ===================== -->
  <section id="accueil" style="max-width:1200px;margin:0 auto;padding:clamp(36px,5vw,72px) 24px clamp(40px,5vw,80px);">
    <div style="display:flex;flex-wrap:wrap;gap:48px;align-items:center;">
      <div style="flex:1 1 460px;">
        <span class="ty-badge"><span class="dot"></span>Mobilités Erasmus+ depuis Talence</span>
        <h1 class="ty-h1">Faire bouger la jeunesse à travers l'Europe</h1>
        <p class="ty-lead">TalenceYouth conçoit et coordonne des mobilités internationales pour les jeunes via Erasmus+, depuis Talence vers toute l'Europe. Esprit critique face à l'IA, inclusion, mobilité durable.</p>
        <div class="ty-actions">
          <a class="ty-btn" href="/digiminds#candidater"><span>Candidater à une mobilité</span><span class="fleche" aria-hidden="true">→</span></a>
          <a class="ty-btn2" href="/partners">Devenir partenaire</a>
        </div>
      </div>
      <div style="flex:1 1 380px;position:relative;min-width:300px;">
        <Photo src={teeNdsm} prioritaire largeurs={[600, 900, 1200]} sizes="(min-width: 1200px) 560px, (min-width: 800px) 45vw, 100vw"
          alt="Trois jeunes du Talence-Europe Express devant le tag TALENCE YOUTH, sur le mur d'expression libre du NDSM à Amsterdam, en août 2026"
          style="display:block;width:100%;height:auto;aspect-ratio:4/3;object-fit:cover;border-radius:24px;box-shadow:0 24px 60px rgba(0,0,0,.09);background:#e6e2db;" />
        <div style="position:absolute;bottom:22px;left:-16px;--r:-4deg;animation:ty-float 6s ease-in-out infinite;background:#fff;border-radius:16px;padding:13px 18px;box-shadow:0 14px 34px rgba(0,0,0,.12);">
          <div style="font-family:'Hanken Grotesk';font-weight:800;font-size:24px;line-height:1;">{nombrePaysPartenaires} pays</div>
          <div style="font-size:12px;color:#6b665e;margin-top:3px;">partenaires actifs</div>
        </div>
      </div>
    </div>
  </section>

  <!-- ===================== CHIFFRES ===================== -->
  <section aria-label="Chiffres clés" style="max-width:1200px;margin:0 auto;padding:0 24px clamp(36px,5vw,64px);">
    <div data-reveal style="background:#1A1A1A;border-radius:28px;padding:clamp(28px,4vw,48px);display:flex;flex-wrap:wrap;gap:28px;justify-content:space-between;">
      <div style="flex:1 1 220px;">
        <div style="font-family:'Hanken Grotesk';font-weight:800;letter-spacing:-.02em;color:#fff;font-size:clamp(2.4rem,4.5vw,3.4rem);line-height:1;">
          <span data-counter={totalSubventions}>{totalSubventions.toLocaleString('fr-FR').replace(/ /g, ' ')}</span> <span style="color:var(--accent);">€</span>
        </div>
        <p style="color:#bdb9b1;font-size:15px;margin:12px 0 0;">de subventions Erasmus+ confirmées</p>
      </div>
      <div style="width:1px;background:rgba(255,255,255,.12);align-self:stretch;"></div>
      <div style="flex:1 1 180px;">
        <div style="font-family:'Hanken Grotesk';font-weight:800;letter-spacing:-.02em;color:#fff;font-size:clamp(2.4rem,4.5vw,3.4rem);line-height:1;"><span data-counter="2">2</span></div>
        <p style="color:#bdb9b1;font-size:15px;margin:12px 0 0;">projets en cours</p>
      </div>
      <div style="width:1px;background:rgba(255,255,255,.12);align-self:stretch;"></div>
      <div style="flex:1 1 180px;">
        <div style="font-family:'Hanken Grotesk';font-weight:800;letter-spacing:-.02em;color:#fff;font-size:clamp(2.4rem,4.5vw,3.4rem);line-height:1;"><span data-counter={nombrePaysPartenaires}>{nombrePaysPartenaires}</span></div>
        <p style="color:#bdb9b1;font-size:15px;margin:12px 0 0;">pays partenaires</p>
      </div>
    </div>
  </section>

  <!-- ===================== MISSION ===================== -->
  <section id="mission" style="max-width:880px;margin:0 auto;padding:clamp(40px,6vw,90px) 24px;text-align:center;">
    <span data-reveal class="ty-eyebrow" style="margin-bottom:18px;">Notre mission</span>
    <h2 data-reveal style="font-family:'Hanken Grotesk';font-weight:800;letter-spacing:-.025em;font-size:clamp(2rem,4.5vw,3.2rem);line-height:1.08;margin:0 0 24px;text-wrap:balance;">Ouvrir l'Europe à tous les jeunes</h2>
    <p data-reveal style="font-size:clamp(1.05rem,1.6vw,1.3rem);line-height:1.65;color:#4a463f;margin:0 0 18px;text-wrap:pretty;">Nous montons des projets Erasmus+ qui mêlent éducation non formelle, engagement européen et impact local. Intelligence artificielle, désinformation, inclusion, environnement : nos thématiques préparent les jeunes aux enjeux de demain.</p>
    <p data-reveal style="font-size:clamp(.98rem,1.4vw,1.1rem);line-height:1.6;color:#6b665e;margin:0;text-wrap:pretty;">Notre signature : une approche pair-à-pair, portée par des étudiants qui parlent le même langage que les jeunes qu'ils accompagnent. Notre audiovisuel, présent sur Instagram et au cœur de chaque projet, donne la parole à ceux qui s'autocensurent.</p>
  </section>

  <!-- ===================== ÉQUIPE ===================== -->
  <section id="equipe" style="max-width:1200px;margin:0 auto;padding:0 24px clamp(40px,6vw,90px);">
    <div class="ty-head">
      <div>
        <span data-reveal class="ty-eyebrow">L'équipe</span>
        <h2 data-reveal class="ty-h2">Cinq profils, une boussole commune</h2>
      </div>
      <span data-reveal style="font-size:15px;color:#6b665e;max-width:380px;">Un bureau composé d'étudiants en master et licence, multilingues et complémentaires. <a href="/association" style="color:var(--accent);font-weight:600;">Découvrir l'association →</a></span>
    </div>
    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:22px;">
      <article data-reveal class="ty-team-card">
        <div style="display:flex;align-items:center;gap:16px;"><div class="ty-avatar is-walid" aria-hidden="true">WT</div><div><h3 class="ty-team-name">Walid Taif</h3><p class="ty-team-role">Président & fondateur</p></div></div>
        <p class="ty-team-bio">Étudiant-entrepreneur (SNEE), Master Commerce International. Vétéran de plus de 10 projets Erasmus+, ancien participant DiscoverEU.</p>
        <div class="ty-team-langs"><span>FR</span><span>EN</span><span>ES</span><span>IT</span><span>Darija</span></div>
        <a class="ty-team-linkedin" href="https://www.linkedin.com/in/walidtaif" target="_blank" rel="noopener">LinkedIn <span aria-hidden="true">→</span></a>
      </article>
      <article data-reveal class="ty-team-card">
        <div style="display:flex;align-items:center;gap:16px;"><div class="ty-avatar is-morad" aria-hidden="true">ML</div><div><h3 class="ty-team-name">Morad Litim</h3><p class="ty-team-role">Vice-président, responsable audiovisuel</p></div></div>
        <p class="ty-team-bio">Master en sciences de l'éducation, futur enseignant. Œil et caméra de TalenceYouth, il transforme les projets en récits visuels.</p>
        <div class="ty-team-langs"><span>FR</span><span>EN</span><span>IT</span><span>Darija</span></div>
        <a class="ty-team-linkedin" href="https://www.linkedin.com/in/morad-litim-600b59313/" target="_blank" rel="noopener">LinkedIn <span aria-hidden="true">→</span></a>
      </article>
      <article data-reveal class="ty-team-card">
        <div style="display:flex;align-items:center;gap:16px;"><div class="ty-avatar is-aziz" aria-hidden="true">AH</div><div><h3 class="ty-team-name">Abdel-Aziz Hamdani</h3><p class="ty-team-role">Trésorier</p></div></div>
        <p class="ty-team-bio">Licence informatique. Boxeur amateur depuis 15 ans. Garant de la rigueur budgétaire et de la discipline collective.</p>
        <div class="ty-team-langs"><span>FR</span><span>EN</span><span>ES</span><span>Tunisien</span></div>
      </article>
      <article data-reveal class="ty-team-card">
        <div style="display:flex;align-items:center;gap:16px;"><div class="ty-avatar is-pablo" aria-hidden="true">PL</div><div><h3 class="ty-team-name">Pablo Lissa</h3><p class="ty-team-role">Secrétaire</p></div></div>
        <p class="ty-team-bio">Master Administration publique. Expert rédaction Erasmus+ KA1, formé à WIPSEE et à la Maison Européenne des Landes.</p>
        <div class="ty-team-langs"><span>FR</span><span>EN</span><span>ES</span><span>IT</span></div>
        <a class="ty-team-linkedin" href="https://www.linkedin.com/in/pablolissa/" target="_blank" rel="noopener">LinkedIn <span aria-hidden="true">→</span></a>
      </article>
      <article data-reveal class="ty-team-card">
        <div style="display:flex;align-items:center;gap:16px;"><div class="ty-avatar is-souhaib" aria-hidden="true">SB</div><div><h3 class="ty-team-name">Sohaïb Benchrif</h3><p class="ty-team-role">Secrétaire adjoint, coordination</p></div></div>
        <p class="ty-team-bio">Polyvalent et multilingue. Coordination, communication et accompagnement des candidats aux mobilités.</p>
        <div class="ty-team-langs"><span>FR</span><span>EN</span><span>ES</span><span>Darija</span></div>
        <a class="ty-team-linkedin" href="https://www.linkedin.com/in/sohaib-benchrif-68494b383/" target="_blank" rel="noopener">LinkedIn <span aria-hidden="true">→</span></a>
      </article>
    </div>
  </section>

  <!-- ===================== PROJETS EN COURS ===================== -->
  <section id="projets" style="max-width:1200px;margin:0 auto;padding:0 24px clamp(40px,6vw,90px);">
    <div class="ty-head">
      <h2 data-reveal class="ty-h2">Nos projets en cours</h2>
      <span data-reveal style="font-size:15px;color:#6b665e;">2 projets confirmés par les agences Erasmus+</span>
    </div>
    <div style="display:flex;flex-wrap:wrap;gap:26px;">

      <article data-reveal style="flex:1 1 380px;background:#fff;border-radius:20px;overflow:hidden;box-shadow:0 8px 30px rgba(0,0,0,.06);display:flex;flex-direction:column;">
        <div style="aspect-ratio:16/9;position:relative;background:linear-gradient(135deg,#0B1E5E 0%,#1B4DE4 55%,#5B7CFF 100%);overflow:hidden;">
          <svg viewBox="0 0 400 225" preserveAspectRatio="xMidYMid slice" aria-hidden="true" style="position:absolute;inset:0;width:100%;height:100%;opacity:.5;">
            <defs><pattern id="dm-grid" x="0" y="0" width="32" height="32" patternUnits="userSpaceOnUse"><path d="M 32 0 L 0 0 0 32" fill="none" stroke="rgba(255,255,255,.18)" stroke-width="1"/></pattern></defs>
            <rect width="400" height="225" fill="url(#dm-grid)"/>
            <g stroke="rgba(255,255,255,.55)" stroke-width="1.2" fill="none">
              <circle cx="80" cy="60" r="4" fill="#fff"/><circle cx="180" cy="40" r="4" fill="#fff"/><circle cx="290" cy="80" r="4" fill="#fff"/><circle cx="340" cy="160" r="4" fill="#fff"/><circle cx="120" cy="170" r="4" fill="#fff"/><circle cx="230" cy="135" r="6" fill="#fff"/>
              <line x1="80" y1="60" x2="230" y2="135"/><line x1="180" y1="40" x2="230" y2="135"/><line x1="290" y1="80" x2="230" y2="135"/><line x1="340" y1="160" x2="230" y2="135"/><line x1="120" y1="170" x2="230" y2="135"/><line x1="80" y1="60" x2="180" y2="40"/><line x1="290" y1="80" x2="340" y2="160"/>
            </g>
          </svg>
          <div style="position:absolute;inset:0;display:flex;align-items:center;justify-content:center;">
            <svg viewBox="0 0 64 64" width="72" height="72" aria-hidden="true" fill="none" stroke="#fff" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" style="filter:drop-shadow(0 4px 16px rgba(0,0,0,.3));">
              <path d="M32 10c-9 0-16 6.5-16 15 0 5 2.5 9.4 6.5 12.2v6.3c0 1.6 1.3 2.9 2.9 2.9h13.2c1.6 0 2.9-1.3 2.9-2.9v-6.3C45.5 34.4 48 30 48 25c0-8.5-7-15-16-15z"/>
              <path d="M26 28h12M24 24c0-3 2-5 4-5M40 24c0-3-2-5-4-5M28 33v4M36 33v4"/><path d="M26 52h12"/>
            </svg>
          </div>
          <span style="position:absolute;top:16px;left:16px;background:#fff;color:var(--accent);font-size:12px;font-weight:600;padding:6px 12px;border-radius:9999px;">KA152, Échange de jeunes</span>
        </div>
        <div style="padding:26px 26px 28px;display:flex;flex-direction:column;flex:1;">
          <h3 class="ty-h3">DigiMinds, esprit critique face à l'IA</h3>
          <p style="font-size:15px;line-height:1.6;color:#4a463f;margin:0 0 18px;">{digiminds.personnes} participants de France, d'Italie, de Turquie, de Pologne et de Lituanie se retrouvent à Bordeaux pendant {digiminds.jours} jours pour décrypter l'intelligence artificielle et la désinformation. Du fact-checking aux ateliers de création, l'objectif : transformer les consommateurs passifs en citoyens numériques actifs.</p>
          <div style="display:flex;flex-wrap:wrap;gap:8px;margin-bottom:22px;">
            <span style={chip}>5 pays</span><span style={chip}>10 jours</span><span style={chip}>36 participants</span><span style={chip}>Erasmus+</span>
          </div>
          <div style="margin-top:auto;display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap;">
            <span style="font-size:14px;font-weight:600;color:#6b665e;">Du 19 au 28 juillet 2027, Bordeaux</span>
            <a href="/digiminds" style="text-decoration:none;display:inline-flex;align-items:center;gap:7px;color:var(--accent);font-weight:600;font-size:15px;">Tout savoir et candidater <span aria-hidden="true">→</span></a>
          </div>
        </div>
      </article>

      <article data-reveal style="flex:1 1 380px;background:#fff;border-radius:20px;overflow:hidden;box-shadow:0 8px 30px rgba(0,0,0,.06);display:flex;flex-direction:column;">
        <div style="aspect-ratio:16/9;position:relative;background:linear-gradient(135deg,#4A2178 0%,#8E3FA8 55%,#E07AA6 100%);overflow:hidden;">
          <svg viewBox="0 0 400 225" preserveAspectRatio="xMidYMid slice" aria-hidden="true" style="position:absolute;inset:0;width:100%;height:100%;">
            <g fill="rgba(255,255,255,.10)"><path d="M0 0h72c-9 60-9 150 0 225H0z"/><path d="M400 0h-72c9 60 9 150 0 225h72z"/></g>
            <g stroke="rgba(255,255,255,.22)" stroke-width="1.2" fill="none"><path d="M22 0c-5 70-5 150 0 225M46 0c-6 70-6 150 0 225"/><path d="M378 0c5 70 5 150 0 225M354 0c6 70 6 150 0 225"/><path d="M96 196h208"/></g>
            <circle cx="200" cy="18" r="70" fill="rgba(255,255,255,.08)"/>
          </svg>
          <div style="position:absolute;inset:0;display:flex;align-items:center;justify-content:center;">
            <svg viewBox="0 0 96 64" width="150" height="100" aria-hidden="true" fill="none" stroke="#fff" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" style="filter:drop-shadow(0 4px 16px rgba(0,0,0,.25));">
              <path d="M12 10c10-4 24-4 34 0v18c0 12-8 20-17 20S12 40 12 28z" fill="rgba(255,255,255,.14)"/><path d="M20 22c2-2 5-2 7 0M31 22c2-2 5-2 7 0M22 33c4 4 10 4 14 0"/>
              <path d="M50 16c10-4 24-4 34 0v18c0 12-8 20-17 20S50 46 50 34z" fill="rgba(255,255,255,.26)"/><path d="M58 29c2 2 5 2 7 0M69 29c2 2 5 2 7 0M60 44c4-4 10-4 14 0"/>
            </svg>
          </div>
          <span style="position:absolute;top:16px;left:16px;background:#fff;color:#8E3FA8;font-size:12px;font-weight:600;padding:6px 12px;border-radius:9999px;">KA152, Échange de jeunes</span>
        </div>
        <div style="padding:26px 26px 28px;display:flex;flex-direction:column;flex:1;">
          <h3 class="ty-h3">Act for Inclusion: Empathy on Stage</h3>
          <p style="font-size:15px;line-height:1.6;color:#4a463f;margin:0 0 18px;">Un échange de jeunes autour du théâtre et de l'inclusion, coordonné par BİLSEM Denizli (Turquie) avec des partenaires de Turquie et d'Italie. TalenceYouth y envoie un groupe de jeunes. Des ateliers pour apprendre à se mettre à la place de l'autre, et une représentation publique montée ensemble.</p>
          <div style="display:flex;flex-wrap:wrap;gap:8px;margin-bottom:22px;">
            <span style={chip}>3 pays</span><span style={chip}>Théâtre</span><span style={chip}>Inclusion</span><span style={chip}>Erasmus+</span>
          </div>
          <div style="margin-top:auto;display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap;">
            <span style="font-size:14px;font-weight:600;color:#6b665e;">Juillet 2027</span>
            <span style="display:inline-flex;align-items:center;gap:7px;color:#6b665e;font-weight:600;font-size:15px;">Candidatures bientôt</span>
          </div>
        </div>
      </article>
    </div>
  </section>

  <!-- ===================== PROJETS RÉALISÉS ===================== -->
  <section id="projets-passes" style="max-width:1200px;margin:0 auto;padding:0 24px clamp(40px,6vw,90px);">
    <div class="ty-head">
      <div>
        <span data-reveal class="ty-eyebrow">Ils l'ont fait</span>
        <h2 data-reveal class="ty-h2">Nos mobilités réalisées</h2>
      </div>
      <span data-reveal style="font-size:15px;color:#6b665e;">Nos jeunes ont déjà parcouru l'Europe</span>
    </div>
    <div style="display:flex;flex-wrap:wrap;gap:26px;">
      {[
        { photo: teeGroupe, alt: 'Les sept voyageurs du Talence-Europe Express sur un pont à Berlin, le château de Charlottenburg au fond', badge: 'Réalisé, mobilité DiscoverEU', titre: 'Talence-Europe Express', texte: "Cinq jeunes de 18 à 21 ans qui n'avaient jamais voyagé sans leurs parents, et deux accompagnateurs. Onze jours en train, de la mer du Nord à Berlin, à travers quatre pays et sans un seul avion. Le programme, ils l'ont construit avec nous.", chips: ['7 voyageurs', '4 pays', '0 avion', 'DiscoverEU'], quand: 'Août 2026, Noordwijk, Amsterdam, Berlin', lien: '/talence-europe-express' },
        { photo: skien, alt: 'Échange de jeunes à Skien, en Norvège, été 2025', badge: 'Réalisé, échange de jeunes', titre: 'Skien, Norvège, aventure en pleine nature', texte: "Une semaine d'échange Erasmus+ à Skien, accueillis par nos partenaires Creatorium International et TYN. Randonnée, accrobranche, camping sous les étoiles, baignade dans un lac glacé. L'Europe vécue de l'intérieur.", chips: ['Nature', 'Plein air', 'Mobilité internationale'], quand: 'Été 2025, Skien (Norvège)' },
        { photo: nogaret, alt: "Échange franco-danois Cultiver le Changement à Nogaret, dans l'Hérault, avril 2026", badge: 'Réalisé, échange franco-danois', titre: 'Cultiver le Changement, Nogaret', texte: "20 jeunes, 10 Français et 10 Danois, réunis pendant une semaine au hameau de Nogaret (Hérault) avec nos partenaires d'In Orbita. Au programme : ateliers écologiques, débats interculturels, cuisine végétarienne, nuits sous les étoiles, et la preuve que la jeunesse européenne a des choses à se dire.", chips: ['20 jeunes', 'France · Danemark', 'Durabilité', 'In Orbita'], quand: 'Avril 2026, Nogaret (Hérault)' },
      ].map((p) => (
        <article data-reveal style="flex:1 1 300px;background:#fff;border-radius:20px;overflow:hidden;box-shadow:0 8px 30px rgba(0,0,0,.06);display:flex;flex-direction:column;">
          <div style="aspect-ratio:16/9;position:relative;background:#e6e2db;">
            <Photo src={p.photo} alt={p.alt} classe="ty-photo" largeurs={[480, 800, 1000]} sizes="(min-width: 1200px) 380px, (min-width: 700px) 50vw, 100vw" />
            <span style="position:absolute;top:16px;left:16px;background:#2E7D6B;color:#fff;font-size:12px;font-weight:600;padding:6px 12px;border-radius:9999px;">{p.badge}</span>
          </div>
          <div style="padding:26px 26px 28px;display:flex;flex-direction:column;flex:1;">
            <h3 class="ty-h3">{p.titre}</h3>
            <p style="font-size:15px;line-height:1.6;color:#4a463f;margin:0 0 18px;">{p.texte}</p>
            <div style="display:flex;flex-wrap:wrap;gap:8px;margin-bottom:22px;">{p.chips.map((c) => <span style={chip}>{c}</span>)}</div>
            <div style="margin-top:auto;display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap;">
              <span style="font-size:14px;font-weight:600;color:#6b665e;">{p.quand}</span>
              {p.lien && <a href={p.lien} style="text-decoration:none;display:inline-flex;align-items:center;gap:7px;color:var(--accent);font-weight:600;font-size:15px;">Lire le récit <span aria-hidden="true">→</span></a>}
            </div>
          </div>
        </article>
      ))}
    </div>
  </section>

  <!-- ===================== VOUS HÉSITEZ ? ===================== -->
  <section id="questions" style="max-width:1200px;margin:0 auto;padding:0 24px clamp(40px,6vw,90px);">
    <div style="display:flex;flex-wrap:wrap;gap:40px;align-items:flex-start;">
      <div style="flex:1 1 300px;">
        <span data-reveal class="ty-eyebrow">Questions fréquentes</span>
        <h2 data-reveal class="ty-h2">Vous hésitez ?</h2>
        <p data-reveal style="font-size:1.05rem;line-height:1.6;color:#4a463f;margin:18px 0 0;max-width:420px;">Beaucoup de jeunes pensent qu'Erasmus+ n'est pas pour eux. Voici les questions qu'on nous pose le plus souvent.</p>
      </div>
      <div class="ty-faq" style="flex:1.4 1 420px;">
        <details>
          <summary>Je n'ai jamais voyagé sans mes parents</summary>
          <div><p>C'est justement pour ça que l'association existe. En 2026, cinq jeunes qui n'étaient jamais partis seuls ont fait 11 jours en train jusqu'à Berlin avec nous et les sept voyageurs sont rentrés avec des souvenirs et un Youthpass (le certificat européen qui reconnaît ce que vous avez appris). Avant chaque départ il y a une réunion de préparation et c'est le moment de dire que c'est votre première fois.</p></div>
        </details>
        <details>
          <summary>Je parle mal anglais</summary>
          <div><p>Pas besoin d'être bilingue : pendant les échanges on parle un anglais simple et on s'entraide. Dans l'équipe on parle aussi français, italien, espagnol et arabe, vous ne resterez jamais bloqué.</p></div>
        </details>
        <details>
          <summary>Je n'ai pas les moyens</summary>
          <div><p>Les projets sont financés par Erasmus+, le programme de l'Union européenne. Pour DigiMinds il n'y a pas de frais de participation : l'auberge, les repas et les activités sont pris en charge, l'adhésion à l'association est gratuite et seuls vos achats personnels restent à votre charge.</p></div>
        </details>
        <details>
          <summary>Je n'y connais rien en IA</summary>
          <div><p>On ne cherche pas des codeurs mais des personnes curieuses. On apprend en faisant, avec des jeux, des débats, des ateliers et des vidéos.</p></div>
        </details>
        <details>
          <summary>Je suis parent et j'ai des questions</summary>
          <div><p>Un chef de groupe de l'association accompagne le groupe français pendant tout l'échange. Pour DigiMinds les jeunes dorment à l'auberge de jeunesse HI de Blanquefort, dans des chambres de 3 ou 4 avec salle de bain, filles et garçons séparés. Écrivez-nous à <a href={`mailto:${asso.email}`}>{asso.email}</a>, on vous répond.</p></div>
        </details>
      </div>
    </div>
  </section>

  <!-- ===================== THÉMATIQUES ===================== -->
  <section id="thematiques" style="max-width:1200px;margin:0 auto;padding:0 24px clamp(40px,6vw,90px);">
