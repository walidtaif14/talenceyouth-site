---
import Base from '../layouts/Base.astro';
import Photo from '../components/Photo.astro';
import { asso, subventions, totalSubventions, euros } from '../data/site';
import teeBerlinUe from '../assets/photos/tee-berlin-centre-ue.jpg';

const bureau = [
  { init: 'WT', c: 'is-walid', nom: 'Walid Taif', role: 'Président & fondateur', bio: 'Étudiant-entrepreneur (SNEE), Master Commerce International. Vétéran de plus de 10 projets Erasmus+, ancien participant DiscoverEU.', langues: ['FR', 'EN', 'ES', 'IT', 'Darija'], lien: 'https://www.linkedin.com/in/walidtaif' },
  { init: 'ML', c: 'is-morad', nom: 'Morad Litim', role: 'Vice-président, responsable audiovisuel', bio: "Master en sciences de l'éducation, futur enseignant. Œil et caméra de TalenceYouth, il transforme les projets en récits visuels.", langues: ['FR', 'EN', 'IT', 'Darija'], lien: 'https://www.linkedin.com/in/morad-litim-600b59313/' },
  { init: 'AH', c: 'is-aziz', nom: 'Abdel-Aziz Hamdani', role: 'Trésorier', bio: 'Licence informatique. Boxeur amateur depuis 15 ans. Garant de la rigueur budgétaire et de la discipline collective.', langues: ['FR', 'EN', 'ES', 'Tunisien'] },
  { init: 'PL', c: 'is-pablo', nom: 'Pablo Lissa', role: 'Secrétaire', bio: 'Master Administration publique. Expert rédaction Erasmus+ KA1, formé à WIPSEE et à la Maison Européenne des Landes.', langues: ['FR', 'EN', 'ES', 'IT'], lien: 'https://www.linkedin.com/in/pablolissa/' },
  { init: 'SB', c: 'is-souhaib', nom: 'Sohaïb Benchrif', role: 'Secrétaire adjoint, coordination', bio: 'Polyvalent et multilingue. Coordination, communication et accompagnement des candidats aux mobilités.', langues: ['FR', 'EN', 'ES', 'Darija'], lien: 'https://www.linkedin.com/in/sohaib-benchrif-68494b383/' },
];
---
<Base
  titre="L'association TalenceYouth : l'équipe, les financements, l'adhésion"
  description="TalenceYouth, association loi 1901 fondée en mars 2025 à Talence et tenue par cinq bénévoles. L'équipe, les subventions Erasmus+ obtenues et l'adhésion gratuite."
>
  <section class="ty-section ty-section--top">
    <div class="ty-split">
      <div>
        <span class="ty-badge"><span class="dot"></span>Association loi 1901</span>
        <h1 class="ty-h1">Une association de jeunes, pour les jeunes</h1>
        <p class="ty-lead">TalenceYouth a été fondée le {asso.fondation} à Talence. Elle est tenue par cinq bénévoles, étudiants en master et en licence, qui montent des projets Erasmus+ pour les 18-30 ans de l'agglomération bordelaise.</p>
        <div class="ty-actions">
          <a class="ty-btn" href={asso.formulaireAdhesion} target="_blank" rel="noopener"><span>Adhérer, c'est gratuit</span><span class="fleche" aria-hidden="true">→</span></a>
          <a class="ty-btn2" href={`mailto:${asso.email}`}>Nous écrire</a>
        </div>
      </div>
      <div class="ty-photo-card">
        <Photo src={teeBerlinUe} prioritaire alt="Des jeunes du Talence-Europe Express avec un drapeau européen au centre d'information de la Commission européenne, à Berlin" style="aspect-ratio:4/3;object-fit:cover;object-position:50% 12%;" />
      </div>
    </div>
  </section>

  <section class="ty-section">
    <div class="ty-head">
      <div>
        <span class="ty-eyebrow" data-reveal>L'équipe</span>
        <h2 class="ty-h2" data-reveal>Cinq profils, une boussole commune</h2>
      </div>
      <span class="ty-muted" data-reveal style="max-width:380px;">Le bureau élu par l'assemblée générale. Tous bénévoles.</span>
    </div>
    <div class="ty-team-grid">
      {bureau.map((m) => (
        <article data-reveal class="ty-team-card">
          <div style="display:flex;align-items:center;gap:16px;"><div class={`ty-avatar ${m.c}`} aria-hidden="true">{m.init}</div><div><h3 class="ty-team-name">{m.nom}</h3><p class="ty-team-role">{m.role}</p></div></div>
          <p class="ty-team-bio">{m.bio}</p>
          <div class="ty-team-langs">{m.langues.map((l) => <span>{l}</span>)}</div>
          {m.lien && <a class="ty-team-linkedin" href={m.lien} target="_blank" rel="noopener">LinkedIn <span aria-hidden="true">→</span></a>}
        </article>
      ))}
    </div>
  </section>

  <section class="ty-section" aria-label="Financements">
    <div class="ty-stats" data-reveal>
      <div><b>{totalSubventions.toLocaleString('fr-FR')} <em>€</em></b><p>de subventions Erasmus+ obtenues depuis 2025</p></div>
      <div><b>{subventions.digiminds.toLocaleString('fr-FR')} <em>€</em></b><p>pour DigiMinds, juillet 2027</p></div>
      <div><b>{subventions.tee.toLocaleString('fr-FR')} <em>€</em></b><p>pour le Talence-Europe Express, août 2026</p></div>
    </div>
  </section>

  <section class="ty-section">
    <div class="ty-cards">
      <article class="ty-card" data-reveal>
        <span class="ty-eyebrow">D'où vient l'argent</span>
        <div class="ty-text">
          <p>Nos projets sont financés par Erasmus+, le programme de l'Union européenne pour la jeunesse, à travers l'Agence Erasmus+ France Jeunesse &amp; Sport.</p>
          <p style="margin:0;">Cet argent paie les voyages, l'hébergement, les repas et les activités des participants. Chaque projet se termine par un rapport final à l'Agence, qui contrôle ce qui a été réalisé.</p>
        </div>
      </article>
      <article class="ty-card" data-reveal>
        <span class="ty-eyebrow">Adhérer</span>
        <div class="ty-text">
          <p>L'adhésion est gratuite et ouverte à tous les 18-30 ans, étudiants ou non, avec ou sans diplôme. Le bénévolat ponctuel est possible sans adhésion.</p>
          <p style="margin:0;"><a href={asso.formulaireAdhesion} target="_blank" rel="noopener">Remplir le formulaire d'adhésion →</a></p>
        </div>
      </article>
      <article class="ty-card" data-reveal>
        <span class="ty-eyebrow">Fiche d'identité</span>
        <dl class="ty-facts">
          <dt>Siège</dt><dd>{asso.adresse}</dd>
          <dt>SIREN</dt><dd>{asso.siren}</dd>
          <dt>OID Erasmus+</dt><dd>{asso.oid}</dd>
          <dt>Contact</dt><dd><a href={`mailto:${asso.email}`}>{asso.email}</a></dd>
        </dl>
      </article>
    </div>
  </section>
</Base>
