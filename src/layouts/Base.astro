---
// Mise en page commune, au style d'origine du site (en-tête crème, pied de page noir).
import '../styles/global.css';
import { asso, clauseUE } from '../data/site';

interface Props {
  titre: string;
  description: string;
  lang?: 'fr' | 'en';
  jsonld?: Record<string, unknown>;
}
const { titre, description, lang = 'fr', jsonld } = Astro.props;
const fr = lang === 'fr';
const chemin = Astro.url.pathname.replace(/\.html$/, '').replace(/\/index$/, '/') || '/';
const canonique = new URL(chemin, Astro.site).href;
const actif = (href: string) => (chemin === href ? 'page' : undefined);

const nav = fr
  ? [
      { href: '/', texte: 'Accueil' },
      { href: '/digiminds', texte: 'DigiMinds' },
      { href: '/talence-europe-express', texte: 'Voyage 2026' },
      { href: '/association', texte: "L'asso" },
      { href: '/partners', texte: 'Partners', lang: 'en' },
    ]
  : [
      { href: '/', texte: 'Home (FR)', lang: 'fr' },
      { href: '/digiminds', texte: 'DigiMinds (FR)', lang: 'fr' },
      { href: '/partners', texte: 'For partners' },
    ];
const navPied = fr
  ? [
      { href: '/', texte: 'Accueil' },
      { href: '/digiminds', texte: 'DigiMinds 2027' },
      { href: '/talence-europe-express', texte: 'Le voyage de 2026' },
      { href: '/association', texte: "L'association" },
      { href: '/partners', texte: 'For partners (EN)' },
    ]
  : [
      { href: '/', texte: 'Home page (French)' },
      { href: '/digiminds', texte: 'DigiMinds 2027 (French)' },
      { href: '/partners', texte: 'For partners' },
    ];
---
<!DOCTYPE html>
<html lang={lang}>
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{titre}</title>
<meta name="description" content={description}>
<meta name="theme-color" content="#F0EEEB">
<link rel="canonical" href={canonique}>
<link rel="icon" type="image/png" href="/images/logo-192.png">
<link rel="apple-touch-icon" href="/images/apple-touch-icon.png">
<meta property="og:type" content="website">
<meta property="og:locale" content={fr ? 'fr_FR' : 'en_GB'}>
<meta property="og:url" content={canonique}>
<meta property="og:title" content={titre}>
<meta property="og:description" content={description}>
<meta property="og:image" content="https://talenceyouth.fr/images/partage.jpg">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:image:alt" content={fr ? "Trois jeunes devant le tag TALENCE YOUTH peint sur un mur d'Amsterdam" : 'Three young people in front of a TALENCE YOUTH tag painted on a wall in Amsterdam'}>
<meta name="twitter:card" content="summary_large_image">
<link rel="preload" href="/fonts/hanken-grotesk-latin.woff2" as="font" type="font/woff2" crossorigin>
<link rel="preload" href="/fonts/inter-latin.woff2" as="font" type="font/woff2" crossorigin>
<script is:inline>document.documentElement.classList.add('js');</script>
{jsonld && <script type="application/ld+json" set:html={JSON.stringify(jsonld)} />}
</head>
<body>

<header style="position:sticky;top:0;z-index:50;background:rgba(240,238,235,.82);-webkit-backdrop-filter:blur(14px);backdrop-filter:blur(14px);border-bottom:1px solid rgba(26,26,26,.06);">
  <div style="max-width:1200px;margin:0 auto;padding:14px 24px;display:flex;align-items:center;gap:24px;flex-wrap:wrap;">
    <a href="/" aria-label={fr ? 'TalenceYouth, accueil' : 'TalenceYouth, home page in French'} style="text-decoration:none;display:flex;align-items:center;gap:10px;color:#1A1A1A;">
      <span style="width:34px;height:34px;border-radius:10px;background:url('/images/logo-96.png') center / cover no-repeat;display:block;"></span>
      <span style="font-family:'Hanken Grotesk';font-weight:800;font-size:19px;letter-spacing:-.02em;">Talence<span style="color:var(--accent);">Youth</span></span>
    </a>
    <nav class="ty-nav-mobile" aria-label={fr ? 'Navigation principale' : 'Main navigation'} style="display:flex;align-items:center;gap:24px;flex:1 1 auto;justify-content:center;flex-wrap:wrap;">
      {nav.map((l) => (
        <a class="ty-nav-link" href={l.href} aria-current={actif(l.href)} hreflang={l.lang} lang={l.lang} style={`color:#1A1A1A;font-size:15px;font-weight:${actif(l.href) ? 700 : 500};white-space:nowrap;`}>{l.texte}</a>
      ))}
    </nav>
    {fr
      ? <a href="/digiminds#candidater" style="text-decoration:none;background:var(--accent);color:#fff;font-weight:600;font-size:15px;padding:10px 20px;border-radius:9999px;white-space:nowrap;">Candidater</a>
      : <a href={`mailto:${asso.email}`} style="text-decoration:none;background:var(--accent);color:#fff;font-weight:600;font-size:15px;padding:10px 20px;border-radius:9999px;white-space:nowrap;">Contact us</a>}
  </div>
</header>

<main>
  <slot />
</main>

<footer id="contact" style="background:#1A1A1A;color:#fff;">
  <div style="max-width:1200px;margin:0 auto;padding:clamp(48px,6vw,84px) 24px 36px;">
    <h2 data-reveal style="font-family:'Hanken Grotesk';font-weight:800;letter-spacing:-.025em;font-size:clamp(2rem,5vw,3.6rem);line-height:1.05;margin:0 0 48px;max-width:760px;text-wrap:balance;">{fr ? 'Là où les rencontres deviennent des projets' : 'Where meetings turn into projects'}</h2>
    <div style="display:flex;flex-wrap:wrap;gap:40px;justify-content:space-between;border-top:1px solid rgba(255,255,255,.12);padding-top:40px;">

      <div style="flex:1 1 240px;max-width:320px;">
        <div style="display:flex;align-items:center;gap:10px;margin-bottom:14px;">
          <span style="width:32px;height:32px;border-radius:9px;background:url('/images/logo-96.png') center / cover no-repeat #fff;display:block;"></span>
          <span style="font-family:'Hanken Grotesk';font-weight:800;font-size:18px;letter-spacing:-.02em;">TalenceYouth</span>
        </div>
        <p style="font-size:14px;line-height:1.6;color:#9b968e;margin:0 0 20px;">{fr ? "Mobilités internationales pour les jeunes via Erasmus+, depuis Talence vers toute l'Europe." : 'International mobility for young people with Erasmus+, from Talence to the whole of Europe.'}</p>
        <div style="display:flex;gap:10px;align-items:center;">
          <a href={asso.instagram} target="_blank" rel="noopener" aria-label="Instagram TalenceYouth" style="text-decoration:none;display:inline-flex;align-items:center;gap:8px;border:1px solid rgba(255,255,255,.18);border-radius:9999px;padding:8px 16px;color:#fff;font-size:13px;font-weight:600;">
            <svg aria-hidden="true" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"/></svg>
            <span>{asso.instagramNom}</span>
          </a>
        </div>
      </div>

      <div style="flex:0 1 auto;">
        <h3 style="font-size:13px;letter-spacing:.06em;text-transform:uppercase;color:#a8a39b;margin:0 0 16px;font-weight:600;">{fr ? 'Navigation' : 'Pages'}</h3>
        <div style="display:flex;flex-direction:column;gap:11px;">
          {navPied.map((l) => <a href={l.href} style="text-decoration:none;color:#d9d5cd;font-size:14px;">{l.texte}</a>)}
        </div>
      </div>

      <div style="flex:0 1 auto;max-width:280px;">
        <h3 style="font-size:13px;letter-spacing:.06em;text-transform:uppercase;color:#a8a39b;margin:0 0 16px;font-weight:600;">{fr ? 'Association' : 'Organisation'}</h3>
        <p style="font-size:14px;line-height:1.7;color:#9b968e;margin:0 0 14px;">
          {fr ? `${asso.forme}, fondée le ${asso.fondation}` : 'Non-profit association (French law of 1901), founded on 27 March 2025'}<br>
          16 avenue de Collegno<br>
          33400 Talence, {fr ? 'Bordeaux Métropole' : 'Bordeaux area, France'}<br>
          SIREN {asso.siren}<br>
          OID Erasmus+ {asso.oid}
        </p>
        <a href={`mailto:${asso.email}`} style="text-decoration:none;color:#d9d5cd;font-size:14px;font-weight:600;border-bottom:1px solid rgba(255,255,255,.2);">{asso.email}</a>
      </div>

      <div style="flex:0 1 auto;max-width:300px;">
        <h3 style="font-size:13px;letter-spacing:.06em;text-transform:uppercase;color:#a8a39b;margin:0 0 16px;font-weight:600;">{fr ? 'Financement' : 'Funding'}</h3>
        <div class="ty-eu-card">
          <img src={fr ? '/images/embleme-ue.png' : '/images/embleme-ue-en.png'} width="600" height={fr ? 135 : 134} loading="lazy" decoding="async" alt={fr ? "Financé par l'Union européenne" : 'Funded by the European Union'}>
        </div>
        <p style="font-size:12px;line-height:1.6;color:#a8a39b;margin:14px 0 0;">{fr ? clauseUE.fr : clauseUE.en}</p>
      </div>
    </div>

    <div style="display:flex;flex-wrap:wrap;gap:16px;justify-content:space-between;align-items:center;border-top:1px solid rgba(255,255,255,.12);margin-top:40px;padding-top:24px;">
      <span style="font-size:13px;color:#a8a39b;">© 2026 TalenceYouth, Talence, France</span>
      <div style="display:flex;gap:22px;flex-wrap:wrap;">
        <a href="/mentions-legales" lang="fr" style="text-decoration:none;color:#9b968e;font-size:13px;">Mentions légales</a>
        <a href="/politique-confidentialite" lang="fr" style="text-decoration:none;color:#9b968e;font-size:13px;">Politique de confidentialité</a>
      </div>
    </div>
  </div>
</footer>

<div id="ty-lightbox" class="ty-lightbox" role="dialog" aria-modal="true" aria-label={fr ? 'Aperçu photo' : 'Photo preview'} aria-hidden="true">
  <div class="ty-lightbox-frame">
    <img id="ty-lightbox-image" class="ty-lightbox-image" alt="">
    <p id="ty-lightbox-caption" class="ty-lightbox-caption"></p>
    <button class="ty-lightbox-close" type="button" aria-label={fr ? 'Fermer' : 'Close'}>×</button>
  </div>
</div>

<script>
  import '../scripts/site.js';
</script>
</body>
</html>
