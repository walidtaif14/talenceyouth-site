---
// Galerie au style d'origine : vignettes cliquables, la photo s'ouvre entière dans la visionneuse du site.
import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';

interface Item { src: ImageMetadata; legende: string; large?: boolean; }
interface Props { items: Item[]; }
const { items } = Astro.props;

const photos = await Promise.all(items.map(async (it) => {
  const vignette = await getImage({ src: it.src, width: it.large ? 1200 : 720, format: 'webp' });
  const grande = await getImage({ src: it.src, width: Math.min(1600, it.src.width), format: 'webp' });
  return { ...it, vignette: vignette.src, grande: grande.src };
}));
---
<div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:18px;">
  {photos.map((p) => (
    <button class={`ty-gallery-tile${p.large ? ' is-wide' : ''}`} type="button" data-reveal aria-haspopup="dialog" data-image={p.grande} data-caption={p.legende} style="display:flex;flex-direction:column;gap:10px;">
      <div style={`aspect-ratio:${p.large ? '5/3' : '4/5'};border-radius:18px;overflow:hidden;position:relative;background:#e6e2db;`}>
        <img class="ty-gallery-img ty-photo" src={p.vignette} alt="" loading="lazy" decoding="async" width={p.large ? 1200 : 720} height={p.large ? 720 : 900}>
        <span class="ty-zoom" aria-hidden="true" style="position:absolute;top:12px;right:12px;width:30px;height:30px;border-radius:50%;background:rgba(26,26,26,.8);color:#fff;display:flex;align-items:center;justify-content:center;font-size:15px;">⤢</span>
      </div>
      <span style="font-size:13px;color:#4a463f;font-weight:500;">{p.legende}</span>
    </button>
  ))}
</div>
