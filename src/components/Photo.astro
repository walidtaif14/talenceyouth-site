---
// Photo optimisée (AVIF et WebP aux tailles utiles), en bichromie riso si demandé.
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';

interface Props {
  src: ImageMetadata;
  alt: string;
  riso?: 'bleu' | 'rose' | false;
  ratio?: string;          // ex. '4 / 3' pour recadrer
  largeurs?: number[];
  sizes?: string;
  prioritaire?: boolean;
  legende?: string;
  classe?: string;
}
const {
  src, alt, riso = false, ratio, largeurs = [480, 800, 1200],
  sizes = '(min-width: 1120px) 560px, (min-width: 860px) 50vw, 100vw',
  prioritaire = false, legende, classe = '',
} = Astro.props;
const widths = largeurs.filter((w) => w <= src.width);
const classes = [riso ? `riso ${riso === 'rose' ? 'riso--rose' : ''}` : '', ratio ? 'riso--recadre' : '', classe].join(' ').trim();
---
<figure class={classes || undefined} style={ratio ? `--ratio: ${ratio}` : undefined}>
  <Picture
    src={src}
    alt={alt}
    widths={widths.length ? widths : [src.width]}
    sizes={sizes}
    formats={['avif', 'webp']}
    fallbackFormat="jpg"
    loading={prioritaire ? 'eager' : 'lazy'}
    fetchpriority={prioritaire ? 'high' : undefined}
    decoding="async"
  />
</figure>
{legende && <p class="legende">{legende}</p>}
