---
// Photo optimisée (AVIF et WebP aux tailles utiles), en couleur, dans le style d'origine.
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';

interface Props {
  src: ImageMetadata;
  alt: string;
  largeurs?: number[];
  sizes?: string;
  prioritaire?: boolean;
  classe?: string;        // ex. 'ty-photo' pour remplir un cadre
  style?: string;         // style de la balise img
}
const {
  src, alt, largeurs = [480, 800, 1200],
  sizes = '(min-width: 1200px) 600px, (min-width: 800px) 50vw, 100vw',
  prioritaire = false, classe, style,
} = Astro.props;
const widths = largeurs.filter((w) => w <= src.width);
---
<Picture
  src={src}
  alt={alt}
  widths={widths.length ? widths : [src.width]}
  sizes={sizes}
  formats={['avif', 'webp']}
  fallbackFormat="jpg"
  loading={prioritaire ? 'eager' : 'lazy'}
  fetchpriority={prioritaire ? 'high' : undefined}
  decoding="async"
  class={classe}
  style={style}
/>
